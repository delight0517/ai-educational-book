<Window x:Class="AiEducationalBook.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Educational Book" Height="820" Width="1320" MinHeight="620" MinWidth="940"
        Background="#F4F6FA" WindowStartupLocation="CenterScreen" Closed="Window_Closed">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#202B3C" />
        <SolidColorBrush x:Key="Muted" Color="#748096" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="13,8"/><Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DDE3EC"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="#29364A"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="3,0,3,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Open" Click="Open_Click"/><Button Content="Save" Click="Save_Click"/><Button Content="Only Chat" Click="ChatTab_Click"/>
                <Button Content="Reload editor module" Click="ReloadModule_Click"/>
            </StackPanel>
            <StackPanel><TextBlock Text="AI Educational Book" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/><TextBlock Text="Write clearly. Read deeply." Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E7EF" BorderThickness="1" CornerRadius="12" Padding="8" Margin="0,0,0,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="← Previous" Click="Previous_Click"/><Button Content="Next →" Click="Next_Click"/></StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="WriteTab" Content="✎  Write" Click="WriteTab_Click"/><Button x:Name="ReadTab" Content="▤  Read" Click="ReadTab_Click"/>
                    <Border Width="1" Height="28" Background="#E2E7EF" Margin="12,0"/>
                    <Button Content="Heading" Click="Heading_Click"/><Button Content="B" FontWeight="Bold" Click="Bold_Click"/><Button Content="I" FontStyle="Italic" Click="Italic_Click"/>
                    <TextBlock x:Name="DocumentName" Text="Untitled book" VerticalAlignment="Center" Margin="14,0,4,0" Foreground="{StaticResource Muted}"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="2">
            <Grid x:Name="EditorView" Visibility="Visible">
                <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" BorderBrush="#E2E7EF" BorderThickness="1" CornerRadius="12" Padding="17" Margin="0,0,14,0">
                    <StackPanel><TextBlock Text="THIS BOOK" FontSize="11" FontWeight="Bold" Foreground="#8994A7" Margin="2,3,0,12"/><TextBlock Text="Contents" FontWeight="SemiBold" FontSize="16" Margin="2,0,0,12"/><ListBox x:Name="EditorToc" BorderThickness="0" SelectionChanged="EditorToc_SelectionChanged"/></StackPanel>
                </Border>
                <Border Grid.Column="1" Background="White" BorderBrush="#E2E7EF" BorderThickness="1" CornerRadius="12" Padding="28">
                    <DockPanel><TextBlock DockPanel.Dock="Bottom" x:Name="EditorHint" Text="Local draft · changes stay on this device" Foreground="#8994A7" FontSize="12" Margin="2,12,0,0"/><RichTextBox x:Name="Editor" BorderThickness="0" VerticalScrollBarVisibility="Auto" FontFamily="Segoe UI" FontSize="16" Foreground="#29364A" AcceptsTab="True" Padding="8" TextChanged="Editor_TextChanged"/></DockPanel>
                </Border>
            </Grid>
            <Grid x:Name="ReaderView" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" BorderBrush="#E2E7EF" BorderThickness="1" CornerRadius="12" Padding="17" Margin="0,0,14,0">
                    <StackPanel><TextBlock Text="READING" FontSize="11" FontWeight="Bold" Foreground="#8994A7" Margin="2,3,0,12"/><TextBlock Text="Contents" FontWeight="SemiBold" FontSize="16" Margin="2,0,0,12"/><ListBox x:Name="ReaderToc" BorderThickness="0" SelectionChanged="ReaderToc_SelectionChanged"/></StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#FFFDF8" BorderBrush="#E5E0D7" BorderThickness="1" CornerRadius="14" Padding="56,48" Margin="0,10">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><RichTextBox x:Name="ReaderPage" IsReadOnly="True" BorderThickness="0" Background="Transparent" VerticalScrollBarVisibility="Disabled" FontFamily="Georgia" FontSize="19" Foreground="#2D3036" Padding="6"/><TextBlock Grid.Row="1" x:Name="PageLabel" Text="1 / 1" HorizontalAlignment="Center" Foreground="#8A867F" Margin="0,20,0,0"/></Grid>
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center"><Button Content="↑" Click="Previous_Click"/><Button Content="↓" Click="Next_Click"/><TextBlock Text="Use ← →" TextAlignment="Center" TextWrapping="Wrap" Foreground="#8994A7" FontSize="11" Margin="2,8"/></StackPanel>
            </Grid>
            <Grid x:Name="ChatView" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" BorderBrush="#E2E7EF" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,14,0">
                    <StackPanel>
                        <TextBlock Text="ONLY CHAT" FontSize="11" FontWeight="Bold" Foreground="#8994A7" Margin="2,3,0,12"/>
                        <TextBlock Text="Ask while you write" FontWeight="SemiBold" FontSize="17" TextWrapping="Wrap"/>
                        <TextBlock Text="Messages go to a new read-only Only Chat conversation on this PC." TextWrapping="Wrap" Foreground="#748096" Margin="0,8,0,14"/>
                        <Button x:Name="ConnectOnlyChatButton" Content="Connect to Only Chat" Click="ConnectOnlyChat_Click" HorizontalAlignment="Stretch"/>
                        <TextBlock x:Name="OnlyChatStatus" Text="Not connected" TextWrapping="Wrap" Foreground="#748096" Margin="4,10,4,16"/>
                        <CheckBox x:Name="IncludeBookContext" Content="Include this book when I send" IsChecked="False"/>
                        <TextBlock Text="When enabled, the current book text is included with the message and sent to the provider selected in Only Chat." TextWrapping="Wrap" Foreground="#8994A7" FontSize="11" Margin="2,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="White" BorderBrush="#E2E7EF" BorderThickness="1" CornerRadius="12" Padding="22">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="ChatMessages"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#F2F5F9" CornerRadius="10" Padding="13" Margin="0,5,0,5" HorizontalAlignment="Left" MaxWidth="780"><TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14" Foreground="#29364A"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                        <TextBox x:Name="ChatComposer" Grid.Row="1" MinHeight="90" MaxHeight="180" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="12" FontSize="14" BorderBrush="#DDE3EC"/>
                        <DockPanel Grid.Row="2" Margin="0,8,0,0"><TextBlock Text="Only Chat processes messages after you press Send." Foreground="#8994A7" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" x:Name="SendChatButton" Content="Send to Only Chat" Click="SendChat_Click" IsDefault="False"/></DockPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <DockPanel Grid.Row="3" Margin="4,12,4,0"><TextBlock x:Name="StatusText" Text="Ready" Foreground="#7A879A"/><TextBlock DockPanel.Dock="Right" x:Name="ModuleText" Text="Modules loading…" Foreground="#7A879A"/></DockPanel>
    </Grid>
</Window>
